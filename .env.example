# KFL admin account (keep real values only in the server environment)
KFL_USERNAME=replace-with-a-unique-username
KFL_PASSWORD=replace-with-a-long-random-password
# Generate at least 32 random characters, for example with: openssl rand -base64 48
KFL_SESSION_SECRET=replace-with-at-least-32-random-characters

# Reuse the existing CMS base URL; never prefix it with NEXT_PUBLIC_.
WORDPRESS_URL=https://cms.momenti.info

# Enable browser-language redirects after the English archive has been translated.
ENGLISH_EDITION_READY=false

# WordPress user with permission to create and publish translated posts.
# Create a dedicated Application Password in that user's WordPress profile.
WP_TRANSLATION_USERNAME=
WP_TRANSLATION_APP_PASSWORD=

# Generate a random secret and keep it only in the server environment.
# Protects POST /api/translations/process and the archive/recent runner.
ARTICLE_TRANSLATION_SECRET=

# Optional path to the Python executable that has Argos Translate installed.
# Linux VPS default: python3. Windows default: python.
ARGOS_PYTHON=

# YouTube Data API v3 key (server-side only; never use NEXT_PUBLIC_)
YOUTUBE_API_KEY=

# Google Analytics 4 Measurement ID (starts with G-)
NEXT_PUBLIC_GA_ID=

# Pruna P-Image-Upscale (server-side only; never prefix with NEXT_PUBLIC_)
PRUNA_API_KEY=
