# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.kfl-enhancer-venv/
/.kfl-esrgan-venv/
/.kfl-tmp/
/scripts/kfl-enhancer/weights/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-release/
/out/

# production
/build
/data/kfl-drafts/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/.next-*/

# Momenti: never commit archives, logs, local caches or empty helper folders
*.tar.gz
*.zip
/ops/deploy/*.log
/ops/deploy/backup-files.txt
/ops/deploy/backup-local-hash.txt
/klan-rss/cache.*
/ekonomia-rss/cache.*
/data/
# deploy key made by ops/github/setup-deploy-key.bat (goes only into GitHub secrets, never into the repo)
/ops/github/deploy_key*
/ops/github/known_hosts.txt
