@import "tailwindcss";



/* =========================================================

   MOMENTI 2.0

   GLOBAL VARIABLES

========================================================= */



:root {

  --momenti-bg: #181b1f;

  --momenti-bg-dark: #111315;

  --momenti-surface: #1d2024;

  --momenti-surface-2: #25282c;



  --momenti-text: #f4ead7;

  --momenti-text-muted: #b8b8b8;



  --momenti-red: #c91427;

  --momenti-red-dark: #c91427;



  --momenti-border: #34373b;



  --container-width: 1200px;

}



/* =========================================================

   RESET

========================================================= */



* {

  box-sizing: border-box;

}



html {

  scroll-behavior: smooth;

}



html,

body {

  margin: 0;

  padding: 0;

  min-height: 100%;

}



body {

  background: var(--momenti-bg);

  color: var(--momenti-text);

  font-family: Arial, Helvetica, sans-serif;

  -webkit-font-smoothing: antialiased;

  text-rendering: optimizeLegibility;

}



a {

  color: inherit;

  text-decoration: none;

}



button,

input,

textarea,

select {

  font: inherit;

}



button {

  border: 0;

}



img {

  display: block;

  max-width: 100%;

}



ul,

ol {

  margin: 0;

  padding: 0;

  list-style: none;

}



::selection {

  background: var(--momenti-red);

  color: #fff;

}



:focus-visible {

  outline: 2px solid var(--momenti-red);

  outline-offset: 3px;

}



/* =========================================================

   GLOBAL CONTAINERS

========================================================= */



.momenti-container {

  width: min(calc(100% - 40px), var(--container-width));

  margin-inline: auto;

}



.momenti-section {

  margin-top: 48px;

}



.section-heading {

  display: flex;

  align-items: center;

  gap: 8px;

  margin-bottom: 20px;

}



.section-heading h2 {

  margin: 0;

  color: var(--momenti-red);

  font-family: Georgia, "Times New Roman", serif;

  font-size: 22px;

  line-height: 1.2;

  font-weight: 700;

}



.heading-mark {

  width: 10px;

  height: 10px;

  flex: 0 0 auto;

  display: block;

  background: var(--momenti-red);

}



/* =========================================================

   HEADER

========================================================= */



.site-header {

  width: 100%;

  background: #181b1f;

}



.header-top {

  height: 105px;

  border-bottom: 1px solid #303338;

}



.header-top-inner {

  position: relative;

  width: 100%;

  height: 100%;

  display: flex;

  align-items: center;

  justify-content: center;

}



.social-links {

  position: absolute;

  left: 0;

  top: 50%;

  transform: translateY(-50%);

  display: flex;

  align-items: center;

  gap: 12px;

}



.social-links a {

  width: 30px;

  height: 30px;

  display: flex;

  align-items: center;

  justify-content: center;

  color: var(--momenti-text);

  font-size: 14px;

  font-weight: 700;

  transition: color 0.2s ease;

}

.social-links a svg,
.footer-socials a svg {
  display: block;
  width: 18px;
  height: 18px;
}



.social-links a:hover {

  color: var(--momenti-red);

}



.site-logo {

  position: absolute;

  left: 50%;

  top: 50%;

  transform: translate(-50%, -50%);

  display: flex;

  align-items: center;

  justify-content: center;

}



.site-logo-image {

  display: block;

  width: 320px;

  height: auto;

  max-width: 100%;

  object-fit: contain;

}



.header-spacer {

  width: 100px;

}



.main-navigation {

  width: 100%;

  height: 34px;

  background: #181b1f;

  border-bottom: 1px solid #25282c;

}



.nav-inner {

  min-height: 34px;

  display: flex;

  align-items: center;

  justify-content: center;

}



.nav-links {

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 25px;

}



.nav-links a {

  position: relative;

  display: inline-flex;

  align-items: center;

  height: 34px;

  color: var(--momenti-text);

  font-size: 14px;

  font-weight: 700;

  transition: color 0.2s ease;

}



.nav-links a:hover {

  color: #fff;

}

.nav-links a.active {

  color: var(--momenti-text);

}



.nav-links a.active::after {

  content: "";

  position: absolute;

  left: 0;

  right: 0;

  bottom: 0;

  height: 3px;

  background: var(--momenti-red);

}



.mobile-menu-button {

  display: none;

}

.mobile-navigation {

  display: none;

}



/* =========================================================

   HOME HERO

========================================================= */



.home-hero {

  width: 100%;

  padding: 24px 0 22px;

}



.home-hero-grid {

  width: min(1200px, calc(100% - 32px));

  margin: 0 auto;

  display: grid;

  grid-template-columns: 300px minmax(400px, 500px) 300px;

  gap: 28px;

  align-items: start;

}



.featured-list {

  display: flex;

  flex-direction: column;

  gap: 20px;

  margin-top: 20px;

}

.featured-heading-mobile {

  display: none;

}



.featured-card {

  margin: 0;

}

.featured-card-category,
.featured-card-excerpt {
  display: none;
}

.featured-list .featured-card:nth-child(2) {

  display: none;

}



.image-placeholder {

  width: 100%;

  aspect-ratio: 16 / 10;

  overflow: hidden;

  background: #24272b;

  position: relative;

}

.featured-image-overlay {
  display: none;
}

.focus-news-section {
  width: 100%;
  margin: 2px 0 0;
  padding: 5px 0 0;
  border-top: 1px solid var(--momenti-border);
}

.focus-news-container {
  width: 100%;
  margin: 0;
}

.focus-news-label {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 5px;
  color: var(--momenti-red);
}

.focus-news-label > span {
  font-size: 17px;
  line-height: 1;
}

.focus-news-label h2 {
  margin: 0;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.focus-news-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
}

.focus-news-card {
  position: relative;
  display: grid;
  grid-template-columns: minmax(180px, 0.55fr) minmax(0, 1fr);
  align-items: center;
  gap: 14px;
  min-width: 0;
  padding: 0;
}

.focus-news-card:first-child {
  padding-left: 0;
}

.focus-news-card:last-child {
  padding-right: 0;
  border-right: 0;
}

.focus-news-image {
  width: 100%;
  height: 104px;
  overflow: hidden;
  border-radius: 6px;
  background: var(--momenti-surface-2);
}

.focus-news-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.focus-news-copy {
  position: relative;
  min-width: 0;
  padding-right: 18px;
}

.focus-news-date {
  margin-bottom: 5px;
  color: var(--momenti-red);
  font-size: 10px;
  font-weight: 600;
}

.focus-news-copy h3 {
  display: -webkit-box;
  overflow: hidden;
  margin: 0;
  color: var(--momenti-text);
  font-size: 18px;
  line-height: 1.25;
  -webkit-line-clamp: 2;
  font-weight: 600;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.focus-news-excerpt {
  display: -webkit-box;
  overflow: hidden;
  margin: 4px 0 0;
  color: var(--momenti-text-muted);
  font-size: 12px;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.focus-news-arrow {
  position: absolute;
  right: 0;
  bottom: 0;
  color: var(--momenti-red);
  font-size: 13px;
}



.image-placeholder img {

  width: 100%;

  height: 100%;

  object-fit: cover;

  display: block;

  transition: transform 0.3s ease;

}



.featured-card:hover .image-placeholder img {

  transform: scale(1.03);

}



.featured-card h3 {

  margin: 10px 0 8px;

  color: #f5ead7;

  font-size: 15px;

  line-height: 1.3;

  font-weight: 700;

}



.post-meta {

  color: #aaa;

  font-size: 11px;

  font-weight: 600;

}



.main-feature {

  min-width: 0;

}



.main-feature-link {

  display: block;

}



.main-video-placeholder {

  position: relative;

  width: 100%;

  aspect-ratio: 9 / 16;

  max-width: 450px;

  max-height: 520px;

  margin: 0 auto;

  background: linear-gradient(145deg, #51484a, #191b1e);

  display: flex;

  align-items: center;

  justify-content: center;

  overflow: hidden;

}

.youtube-short-frame {

  position: relative;

  width: min(100%, 500px);

  aspect-ratio: 5 / 6;

  margin: 0 auto;

  overflow: hidden;

  background-color: #080808;

  background-position: center;

  background-size: cover;

}

.youtube-short-frame iframe {

  position: absolute;

  top: 50%;

  left: 50%;

  display: block;

  width: 148%;

  height: 148%;

  transform: translate(-50%, -50%);

  transform-origin: center;

  border: 0;

}

.youtube-short-title {

  display: block;

  color: inherit;

  text-decoration: none;

}



.play-button {

  width: 70px;

  height: 70px;

  border-radius: 50%;

  display: flex;

  align-items: center;

  justify-content: center;

  background: var(--momenti-red);

  color: #fff;

  font-size: 28px;

  padding-left: 5px;

}



.main-feature h1 {

  margin: 14px 0 8px;

  color: #f5ead7;

  font-size: 18px;

  line-height: 1.2;

  font-weight: 800;

}



.right-column {

  min-width: 0;

}



.sponsor-box {

  margin-bottom: 22px;

  text-align: center;

}



.sponsor-box > span {

  display: block;

  margin-bottom: 8px;

  color: #aaa;

  font-size: 11px;

  font-weight: 600;

}



.sponsor-placeholder {

  position: relative;

  width: 70%;

  margin-inline: auto;

  aspect-ratio: 1;

  overflow: hidden;

  background: #24272b;

  color: #aaa;

  font-size: 13px;

}

.sponsor-ad-image {

  object-fit: contain;

}

.sponsor-ad-mobile {
  display: none;
}



.trending-box {

  margin-top: 12px;

}



.trending-item {
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr);
  gap: 7px;
  padding: 11px 0;
  border-bottom: 1px solid #2d3034;
}



.trending-number {

  color: var(--momenti-red);

  font-size: 11px;

  font-weight: 800;

}



.trending-item h3 {

  margin: 0;

  color: #f5ead7;

  font-size: 13px;

  line-height: 1.35;

  font-weight: 700;

}



/* =========================================================

   HOMEPAGE - LATEST NEWS

========================================================= */



.latest-news-section {

  width: 100%;

  padding: 0 0 50px;

}



.latest-news-container {

  width: min(1200px, calc(100% - 32px));

  margin: 0 auto;

}



.latest-news-heading {

  margin-bottom: 20px;

}

.latest-news-heading h2 {
  color: var(--momenti-text);
}

.latest-news-heading .heading-mark {
  width: 20px;
  height: 3px;
}

.latest-news-all {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-left: auto;
  color: var(--momenti-red);
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
}

.latest-news-all span {
  font-size: 18px;
  line-height: 1;
  transition: transform 0.2s ease;
}

.latest-news-all:hover span {
  transform: translateX(3px);
}



.latest-news-grid {

  display: grid;

  grid-template-columns: repeat(4, minmax(0, 1fr));

  gap: 22px;

}



.latest-news-card {

  display: block;

  min-width: 0;

}



.latest-news-image {

  position: relative;

  width: 100%;

  aspect-ratio: 8 / 3;

  overflow: hidden;

  background: #24272b;

}



.latest-news-image img {

  width: 100%;

  height: 100%;

  object-fit: cover;

  transition: transform 0.3s ease;

}



.latest-news-card:hover .latest-news-image img {

  transform: scale(1.03);

}



.latest-news-content {

  padding-top: 11px;

}



.latest-news-category {

  position: absolute;
  bottom: 8px;
  left: 8px;
  display: inline-flex;
  align-items: center;
  min-height: 22px;
  padding: 3px 8px;
  border-radius: 3px;
  background: var(--momenti-red);
  color: #fff;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.35px;

}



.latest-news-content h3 {

  margin: 0 0 8px;

  color: var(--momenti-text);

  font-family: Georgia, "Times New Roman", serif;

  font-size: 17px;

  line-height: 1.3;

  font-weight: 700;

}



.latest-news-date {

  display: flex;
  align-items: center;
  gap: 6px;

  color: var(--momenti-text-muted);

  font-size: 11px;

  font-weight: 600;

}

.latest-news-date svg {
  width: 13px;
  height: 13px;
  flex: 0 0 auto;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.4;
}



/* =========================================================

   POLITICS

========================================================= */



/* =========================================================

   POLITIKË / KOSOVË / MAGAZINË

========================================================= */



.politics-section {

  width: 100%;

  margin-top: 10px;

  padding: 38px 0 70px;

  background: #111315;

  border-top: 1px solid #292c30;

  border-bottom: 1px solid #292c30;

}



.kosovo-section,

.magazine-section {

  width: 100%;

  padding: 10px 0 70px;

}





/* =========================================================

   CONTAINERS

========================================================= */



.politics-container,

.kosovo-container,

.magazine-container {

  width: min(1200px, calc(100% - 32px));

  margin: 0 auto;

}





/* =========================================================

   SECTION HEADINGS

========================================================= */



.politics-heading,

.kosovo-heading,

.magazine-heading {

  margin-bottom: 20px;

}





/* =========================================================

   POLITIKË / MAGAZINË GRID

========================================================= */



.politics-grid,

.magazine-grid {

  display: grid;

  grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);

  gap: 30px;

}





/* =========================================================

   MAIN ARTICLES

========================================================= */



.politics-main-card,

.magazine-main-card {

  display: block;

  min-width: 0;

}



.politics-main-image,

.magazine-main-image {

  width: 100%;

  aspect-ratio: 16 / 10;

  overflow: hidden;

  background: #24272b;

}



.politics-main-image img,

.magazine-main-image img {

  width: 100%;

  height: 100%;

  object-fit: cover;

  transition: transform 0.3s ease;

}



.politics-main-card:hover .politics-main-image img,

.magazine-main-card:hover .magazine-main-image img {

  transform: scale(1.03);

}





/* =========================================================

   CATEGORY LABEL

========================================================= */



.politics-category,

.magazine-category {

  margin-top: 11px;

  margin-bottom: 6px;

  color: var(--momenti-red);

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 0.5px;

}





/* =========================================================

   MAIN TITLES

========================================================= */



.politics-main-card h3,

.magazine-main-card h3 {

  margin: 0 0 9px;

  color: var(--momenti-text);

  font-family: Georgia, "Times New Roman", serif;

  font-size: 26px;

  line-height: 1.2;

  font-weight: 700;

}



.politics-main-card:hover h3,

.magazine-main-card:hover h3 {

  color: #fff;

}





/* =========================================================

   DATE

========================================================= */



.politics-date,

.magazine-date {

  color: var(--momenti-text-muted);

  font-size: 11px;

  font-weight: 600;

}





/* =========================================================

   SIDE ARTICLES

========================================================= */



.politics-side,

.magazine-side {

  display: flex;

  flex-direction: column;

  gap: 18px;

}





/* =========================================================

   SIDE CARDS

========================================================= */



.politics-small-card,

.magazine-small-card {

  display: grid;

  grid-template-columns: 150px minmax(0, 1fr);

  gap: 15px;

  padding-bottom: 18px;

  border-bottom: 1px solid var(--momenti-border);

}



.politics-small-card:last-child,

.magazine-small-card:last-child {

  border-bottom: 0;

  padding-bottom: 0;

}





/* =========================================================

   SIDE IMAGES

========================================================= */



.politics-small-image,

.magazine-small-image {

  width: 150px;

  aspect-ratio: 16 / 10;

  overflow: hidden;

  background: #24272b;

}



.politics-small-image img,

.magazine-small-image img {

  width: 100%;

  height: 100%;

  object-fit: cover;

  transition: transform 0.3s ease;

}



.politics-small-card:hover .politics-small-image img,

.magazine-small-card:hover .magazine-small-image img {

  transform: scale(1.03);

}





/* =========================================================

   SIDE TITLES

========================================================= */



.politics-small-content,

.magazine-small-content {

  min-width: 0;

}



.politics-small-content h3,

.magazine-small-content h3 {

  margin: 0 0 8px;

  color: var(--momenti-text);

  font-family: Georgia, "Times New Roman", serif;

  font-size: 16px;

  line-height: 1.3;

  font-weight: 700;

}



.politics-small-card:hover h3,

.magazine-small-card:hover h3 {

  color: #fff;

}





/* =========================================================

   TABLET

========================================================= */



@media (max-width: 1100px) {



  .politics-grid,

  .magazine-grid {

    grid-template-columns: minmax(0, 1.45fr) minmax(320px, 1fr);

    gap: 20px;

  }



  .politics-small-card,

  .magazine-small-card {

    grid-template-columns: 120px minmax(0, 1fr);

    gap: 12px;

  }



  .politics-small-image,

  .magazine-small-image {

    width: 120px;

  }

}





/* =========================================================

   MOBILE

========================================================= */



@media (max-width: 768px) {

  .header-top {
    position: relative;
    height: 72px;
  }

  .header-top-inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-menu-button {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 0;
    background: transparent;
    cursor: pointer;
    z-index: 110;
  }

  .mobile-menu-button span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--momenti-text);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .mobile-menu-button.is-open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-menu-button.is-open span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-button.is-open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .social-links,
  .header-spacer {
    display: none;
  }

  .site-logo-image {
    width: 190px;
  }

  .main-navigation {
    display: none;
  }

  .mobile-navigation {
    position: absolute;
    top: 72px;
    left: 0;
    right: 0;
    z-index: 100;
    display: none;
    flex-direction: column;
    background: #181b1f;
    border-top: 1px solid var(--momenti-border);
    border-bottom: 1px solid var(--momenti-border);
  }

  .mobile-navigation.is-open {
    display: flex;
  }

  .mobile-navigation a {
    display: block;
    padding: 14px 18px;
    color: var(--momenti-text);
    font-size: 14px;
    font-weight: 700;
    border-bottom: 1px solid var(--momenti-border);
  }

  .mobile-navigation a:last-child {
    border-bottom: 0;
  }

  .mobile-navigation a:hover,
  .mobile-navigation a.active {
    color: #fff;
    background: #202328;
  }

  .mobile-navigation a.active {
    box-shadow: inset 3px 0 0 var(--momenti-red);
  }

  .politics-section {

    margin-top: 5px;

    padding: 30px 0 50px;

  }



  .kosovo-section,

  .magazine-section {

    padding: 5px 0 50px;

  }



  .politics-container,

  .kosovo-container,

  .magazine-container {

    width: calc(100% - 18px);

  }



  .politics-grid,

  .magazine-grid {

    grid-template-columns: 1fr;

    gap: 25px;

  }



  .politics-main-card h3,

  .magazine-main-card h3 {

    font-size: 21px;

  }



  .politics-small-card,

  .magazine-small-card {

    grid-template-columns: 120px minmax(0, 1fr);

    gap: 12px;

    padding: 14px 0;

  }



  .politics-small-card:first-child,

  .magazine-small-card:first-child {

    padding-top: 0;

  }



  .politics-small-image,

  .magazine-small-image {

    width: 120px;

  }



  .politics-small-content h3,

  .magazine-small-content h3 {

    font-size: 15px;

  }

}





/* =========================================================

   SMALL PHONES

========================================================= */



@media (max-width: 480px) {



  .politics-small-card,

  .magazine-small-card {

    grid-template-columns: 105px minmax(0, 1fr);

    gap: 10px;

  }



  .politics-small-image,

  .magazine-small-image {

    width: 105px;

  }



  .politics-small-content h3,

  .magazine-small-content h3 {

    font-size: 14px;

  }

}

/* =========================================================

   KOSOVË

========================================================= */



.kosovo-grid {

  display: grid;

  grid-template-columns: repeat(4, minmax(0, 1fr));

  gap: 22px;

}



.kosovo-card {

  display: block;

  min-width: 0;

