/* Keep the YouTube Short at the same vertical 9:16 size across narrow screens,
   without cropping the embedded player's controls. */
@media (max-width: 1199px) {
  .youtube-short-frame {
    width: min(100%, 390px);
    max-width: 390px;
    aspect-ratio: 9 / 16;
    margin-right: auto;
    margin-left: auto;
    overflow: hidden;
    border-radius: 10px;
  }

  .youtube-short-frame iframe {
    inset: 0;
    width: 100%;
    height: 100%;
    transform: none;
  }
}

@media (max-width: 768px) {
  .youtube-short-frame {
    width: min(100%, 430px);
    max-width: 430px;
    aspect-ratio: 4 / 5;
    max-height: min(68svh, 540px);
    isolation: isolate;
    background-color: #111315;
  }

  .youtube-short-frame::before {
    position: absolute;
    z-index: -1;
    inset: -18px;
    content: "";
    background-image: inherit;
    background-position: center;
    background-size: cover;
    filter: blur(18px) brightness(0.72);
    transform: scale(1.06);
  }

  .youtube-short-frame iframe {
    top: 0;
    left: 50%;
    width: auto;
    height: 100%;
    max-width: 100%;
    aspect-ratio: 9 / 16;
    transform: translateX(-50%);
  }
}

